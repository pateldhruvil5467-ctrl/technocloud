# Template for the environment variable(s) TechnoCloud's frontend needs.
# Copy the relevant values into a .env.production file (not committed with
# a real deployment URL) or configure them directly in your hosting
# platform's environment settings before deploying.
#
# REACT_APP_API_URL must point at the deployed TechnoCloud backend API.
# This is a URL, not a secret — do not put credentials in frontend
# environment files, since anything prefixed REACT_APP_ is bundled into
# the public build output.
REACT_APP_API_URL=http://localhost:5000
