# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on.
PORT=5000

# MongoDB connection string (Atlas or local). Contains credentials —
# keep this in .env only, never commit or share it.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Secret used to sign/verify JWTs. Use a long, random value of your own —
# do not reuse this example value in any real environment.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: how long an issued JWT stays valid. Defaults to "7d".
# JWT_EXPIRES_IN=7d

# Origin of the deployed frontend, used to restrict CORS to that origin
# only. Defaults to http://localhost:3000 (local dev) if unset — set
# this explicitly in production to your real frontend URL.
CLIENT_ORIGIN=http://localhost:3000

# Optional: override the auth rate limiter applied to
# POST /api/auth/login and POST /api/auth/register. Values shown below
# are the built-in defaults (15 minutes, 10 attempts per IP per window).
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10

# Optional: override the public-read rate limiter applied to
# GET /api/v1/tracks and GET /api/v1/artists (one shared limiter/counter
# per IP). Values shown below are the built-in defaults (15 minutes, 300
# requests per IP per window) — deliberately generous for normal
# browsing/searching, not a login-style threshold.
# PUBLIC_READ_RATE_LIMIT_WINDOW_MS=900000
# PUBLIC_READ_RATE_LIMIT_MAX=300

# Optional: identifies which environment this is (affects, e.g., how
# much error detail is logged server-side). Defaults to "development".
# NODE_ENV=production

# Optional: maximum accepted audio upload size in bytes. Defaults to
# 20MB (20971520).
# UPLOAD_MAX_BYTES=20971520

# Optional: AI-powered natural-language search intent (services/aiProvider.js).
# Entirely optional — the app starts and runs normally without it;
# interpretSearchIntent() simply returns 503 AI_PROVIDER_UNAVAILABLE until
# a key is set. Get a free API key (no credit card required) at
# https://aistudio.google.com/apikey, then set:
# GEMINI_API_KEY=your-gemini-api-key
#
# Which provider implementation services/aiProvider.js dispatches to.
# "gemini" is the only one that exists today.
# AI_PROVIDER=gemini
#
# The free-tier-eligible Gemini model to call. Google occasionally
# renames/retires free-tier model ids — update this if the default ever
# stops working, no code change needed.
# GEMINI_MODEL=gemini-2.0-flash
#
# How long to wait for a Gemini response before aborting and falling back.
# AI_REQUEST_TIMEOUT_MS=8000
