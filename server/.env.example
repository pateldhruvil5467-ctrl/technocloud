# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on.
PORT=5000

# MongoDB connection string (Atlas or local). Contains credentials —
# keep this in .env only, never commit or share it.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Secret used to sign/verify JWTs. Use a long, random value of your own —
# do not reuse this example value in any real environment.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: how long an issued JWT stays valid. Defaults to "7d".
# JWT_EXPIRES_IN=7d

# Origin of the deployed frontend, used to restrict CORS to that origin
# only. Defaults to http://localhost:3000 (local dev) if unset — set
# this explicitly in production to your real frontend URL.
CLIENT_ORIGIN=http://localhost:3000

# Optional: override the auth rate limiter applied to
# POST /api/auth/login and POST /api/auth/register. Values shown below
# are the built-in defaults (15 minutes, 10 attempts per IP per window).
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10

# Optional: override the public-read rate limiter applied to
# GET /api/v1/tracks and GET /api/v1/artists (one shared limiter/counter
# per IP). Values shown below are the built-in defaults (15 minutes, 300
# requests per IP per window) — deliberately generous for normal
# browsing/searching, not a login-style threshold.
# PUBLIC_READ_RATE_LIMIT_WINDOW_MS=900000
# PUBLIC_READ_RATE_LIMIT_MAX=300

# Optional: identifies which environment this is (affects, e.g., how
# much error detail is logged server-side). Defaults to "development".
# NODE_ENV=production

# Optional: maximum accepted audio upload size in bytes. Defaults to
# 20MB (20971520).
# UPLOAD_MAX_BYTES=20971520

# Optional: AI-powered natural-language search intent (services/aiProvider.js).
# Entirely optional — the app starts and runs normally without it;
# interpretSearchIntent() simply returns 503 AI_PROVIDER_UNAVAILABLE until
# a key is set. Get a free API key (no credit card required) at
# https://aistudio.google.com/apikey, then set:
# GEMINI_API_KEY=your-gemini-api-key
#
# Which provider implementation services/aiProvider.js dispatches to.
# "gemini" is the only one that exists today.
# AI_PROVIDER=gemini
#
# The free-tier-eligible Gemini model to call. Google occasionally
# renames/retires free-tier model ids — update this if the default ever
# stops working, no code change needed.
# GEMINI_MODEL=gemini-2.0-flash
#
# How long to wait for a Gemini response before aborting and falling back.
# AI_REQUEST_TIMEOUT_MS=8000

# Optional: override the dedicated rate limiter applied to
# POST /api/v1/discovery/interpret. Kept separate from the auth and
# public-read limiters above since an accepted request here can trigger
# a real, billed external AI call. Values shown below are the built-in
# defaults (15 minutes, 20 requests per IP per window) — conservative on
# purpose; raise it if real usage warrants it.
# AI_INTERPRET_RATE_LIMIT_WINDOW_MS=900000
# AI_INTERPRET_RATE_LIMIT_MAX=20

# Optional: media storage. "local" (the default) is the only provider
# actually wired into the existing upload/playback flow (Studio upload,
# PlayerContext) — every current behavior is unchanged. Nothing below is
# required while this stays "local".
# MEDIA_STORAGE_PROVIDER=local
#
# The following are recognized once MEDIA_STORAGE_PROVIDER=s3. None of
# these are secrets, so real (non-placeholder) values are safe to set
# here. S3_BUCKET/S3_REGION become required for
# POST /api/v1/media/upload-intent (V5.2-B2) to issue a presigned upload
# URL; CLOUDFRONT_DOMAIN is a separate, playback-only requirement (not
# needed just to generate a presigned PUT URL) — see
# services/media/s3.js.
#
# AWS credential configuration is intentionally NOT listed here: this
# app never reads or holds a credential env var itself. It relies
# entirely on the AWS SDK's standard credential provider chain
# (environment variables it reads directly, a shared AWS config/
# credentials file, or an IAM role attached to the runtime) — see
# services/media/s3.js's getClient(). Configure credentials the AWS SDK
# will discover on its own, not through this file.
# S3_BUCKET=your-bucket-name
# S3_REGION=your-bucket-region
# CLOUDFRONT_DOMAIN=your-distribution-id.cloudfront.net
# MEDIA_PRESIGNED_URL_EXPIRY_SECONDS=300

# Optional: override the dedicated rate limiter applied to
# POST /api/v1/media/upload-intent (V5.2-B2). Kept separate from every
# other limiter since an accepted request here mints real, usable signed
# S3 upload authority. Values shown below are the built-in defaults (15
# minutes, 20 requests per IP per window).
# MEDIA_UPLOAD_INTENT_RATE_LIMIT_WINDOW_MS=900000
# MEDIA_UPLOAD_INTENT_RATE_LIMIT_MAX=20
