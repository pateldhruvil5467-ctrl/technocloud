# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on.
PORT=5000

# MongoDB connection string (Atlas or local). Contains credentials —
# keep this in .env only, never commit or share it.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Secret used to sign/verify JWTs. Use a long, random value of your own —
# do not reuse this example value in any real environment.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: how long an issued JWT stays valid. Defaults to "7d".
# JWT_EXPIRES_IN=7d

# Origin of the deployed frontend, used to restrict CORS to that origin
# only. Defaults to http://localhost:3000 (local dev) if unset — set
# this explicitly in production to your real frontend URL.
CLIENT_ORIGIN=http://localhost:3000

# Optional: override the auth rate limiter applied to
# POST /api/auth/login and POST /api/auth/register. Values shown below
# are the built-in defaults (15 minutes, 10 attempts per IP per window).
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10

# Optional: identifies which environment this is (affects, e.g., how
# much error detail is logged server-side). Defaults to "development".
# NODE_ENV=production

# Optional: maximum accepted audio upload size in bytes. Defaults to
# 20MB (20971520).
# UPLOAD_MAX_BYTES=20971520
